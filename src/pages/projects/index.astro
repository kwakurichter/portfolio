---
import BaseLayout from "../../layouts/BaseLayout.astro";

type ContentModule = {
  frontmatter: {
    title: string;
    summary: string;
    image?: string;
    tags?: string[];
    order?: number;
  };
};

const modules = import.meta.glob<ContentModule>("../../content/projects/*.md", { eager: true });
const projects = Object.entries(modules)
  .map(([path, module]) => ({
    slug: path.split("/").pop()?.replace(".md", "") ?? "",
    ...module.frontmatter,
  }))
  .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));
---

<BaseLayout title="Projects | Kwaku Richter">
  <section class="section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Projects</p>
        <h1>Engineering work with real constraints.</h1>
      </div>
      <p>
        Research platforms, mechanical design projects, analysis reports, and
        personal builds pulled from the previous WordPress site and local resources.
      </p>
    </div>
    <div class="grid">
      {projects.map((project) => (
        <article class="card">
          {project.image && <img src={project.image} alt="" />}
          <div class="card-body">
            <div class="card-meta">
              {(project.tags ?? []).map((tag) => <span class="tag">{tag}</span>)}
            </div>
            <h3>{project.title}</h3>
            <p>{project.summary}</p>
            <a class="card-link" href={`/projects/${project.slug}/`}>View project</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
