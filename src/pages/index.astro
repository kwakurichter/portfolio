---
import BaseLayout from "../layouts/BaseLayout.astro";

type ContentModule = {
  frontmatter: {
    title: string;
    summary: string;
    image?: string;
    tags?: string[];
    order?: number;
    role?: string;
    organization?: string;
    period?: string;
    featured?: boolean;
  };
};

const projectModules = import.meta.glob<ContentModule>("../content/projects/*.md", {
  eager: true,
});

const experienceModules = import.meta.glob<ContentModule>("../content/experience/*.md", {
  eager: true,
});

const toItems = (modules: Record<string, ContentModule>) =>
  Object.entries(modules)
    .map(([path, module]) => ({
      slug: path.split("/").pop()?.replace(".md", "") ?? "",
      ...module.frontmatter,
    }))
    .sort((a, b) => (a.order ?? 99) - (b.order ?? 99));

const projects = toItems(projectModules).filter((project) => project.featured !== false);
const experience = toItems(experienceModules);
const initialExperience = experience.slice(0, 4);
const additionalExperience = experience.slice(4);

const skills = [
  {
    title: "Embedded & Robotics",
    items: ["C++", "Python", "ArduPilot", "MAVLink", "STM32", "UART/SPI/I2C"],
  },
  {
    title: "Mechanical Design",
    items: ["SolidWorks", "AutoCAD", "Fusion 360", "GD&T", "DFM", "Prototyping"],
  },
  {
    title: "Analysis",
    items: ["CFD", "thermal loads", "sensor fusion", "test planning", "MATLAB"],
  },
  {
    title: "Systems",
    items: ["Linux", "TCP/UDP", "SAP PM", "IBM Maximo", "technical documentation"],
  },
];
---

<BaseLayout>
  <section class="hero" style="background-image: url('/images/general/hero.jpg')">
    <div class="hero-copy">
      <h1>Kwaku Richter</h1>
      <p class="lede">Mechanical Engineering Portfolio</p>
      <div class="hero-actions">
        <a class="button" href="/contact/">Get In Touch</a>
      </div>
    </div>
  </section>

  <section class="section intro-band">
    <div class="inner">
      <p class="lede">
        Thanks for visiting my portfolio, my name's Kwaku! I'm a Mechanical
        Engineering MASc candidate at the University of Ottawa, building micro-UAV
        swarm platforms, embedded peer-to-peer communication systems, and practical
        hardware from CAD to testing.
      </p>
      <div class="hero-actions">
        <a class="button" href="/projects/">View projects</a>
        <a class="button secondary" href="/downloads/kwaku-richter-resume.pdf">Download resume</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="split">
      <img src="/images/general/profile.jpg" alt="Portrait of Kwaku Richter" />
      <div>
        <p class="eyebrow">About</p>
        <h2>Hands-on engineering, from analysis to working hardware.</h2>
        <p>
          My work spans embedded systems, mechanical design, HVAC and thermal
          analysis, and rapid prototyping. I'm always eager to challenge myself by
          learning something new or by taking on ambitious technical challenges that
          push me to build practical solutions.
        </p>
        <div class="hero-actions">
          <a class="button secondary" href="/about/">More about me</a>
          <a class="button secondary" href="mailto:kwakurichter@gmail.com">Get in touch</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="section-head compact">
      <div>
        <p class="eyebrow">Experience</p>
        <p>
          Robotics research, open-source autopilot work, mechanical building design,
          HVAC systems, and asset data projects.
        </p>
      </div>
    </div>
    <div class="grid four experience-grid">
      {initialExperience.map((item) => (
        <article class="card">
          {item.image && <img src={item.image} alt="" />}
          <div class="card-body">
            <div class="card-meta">
              <span class="tag">{item.period}</span>
            </div>
            <h3>{item.title}</h3>
            <p>{item.organization}</p>
            <p>{item.summary}</p>
            <a class="card-link" href={`/experience/${item.slug}/`}>Read more</a>
          </div>
        </article>
      ))}
    </div>
    {
      additionalExperience.length > 0 && (
        <div class="reveal-block reveal-block-dark" data-reveal>
          <div class="reveal-fade" aria-hidden="true"></div>
          <button
            class="button secondary reveal-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="more-experience"
            data-more-label="More experience"
            data-less-label="Less experience"
          >
            More experience
          </button>
          <div class="reveal-content" id="more-experience" hidden>
            <div class="grid four experience-grid">
              {additionalExperience.map((item) => (
                <article class="card">
                  {item.image && <img src={item.image} alt="" />}
                  <div class="card-body">
                    <div class="card-meta">
                      <span class="tag">{item.period}</span>
                    </div>
                    <h3>{item.title}</h3>
                    <p>{item.organization}</p>
                    <p>{item.summary}</p>
                    <a class="card-link" href={`/experience/${item.slug}/`}>Read more</a>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      )
    }
  </section>

  <section class="section">
    <div class="section-head compact">
      <div>
        <p class="eyebrow">Projects</p>
        <p>
          A mix of research platforms, capstone hardware, mechanical analysis,
          and personal systems projects.
        </p>
      </div>
    </div>
    <div class="carousel" data-carousel>
      <div class="carousel-track" data-carousel-track aria-live="polite">
        {projects.map((project, index) => (
          <article class="card carousel-card" data-carousel-card aria-hidden={index > 2}>
            {project.image && <img src={project.image} alt="" />}
            <div class="card-body">
              <div class="card-meta">
                {(project.tags ?? []).slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              <a class="card-link" href={`/projects/${project.slug}/`}>View project</a>
            </div>
          </article>
        ))}
      </div>
      <div class="carousel-controls" aria-label="Project carousel controls">
        <button class="button secondary" type="button" data-carousel-prev>Previous</button>
        <span class="carousel-status" data-carousel-status>1-3 / {projects.length}</span>
        <button class="button secondary" type="button" data-carousel-next>Next</button>
      </div>
    </div>
  </section>

  <section class="section dark">
    <div class="section-head compact label-only">
      <div>
        <p class="eyebrow">Skills</p>
      </div>
    </div>
    <div class="skills">
      {skills.map((skill) => (
        <section>
          <h3>{skill.title}</h3>
          <ul>
            {skill.items.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  const revealBlocks = document.querySelectorAll("[data-reveal]");

  revealBlocks.forEach((block) => {
    const button = block.querySelector<HTMLButtonElement>(".reveal-toggle");
    const content = block.querySelector<HTMLElement>(".reveal-content");

    if (!button || !content) {
      return;
    }

    button.addEventListener("click", () => {
      const isOpen = button.getAttribute("aria-expanded") === "true";
      const nextOpen = !isOpen;

      button.setAttribute("aria-expanded", String(nextOpen));
      button.textContent = nextOpen
        ? button.dataset.lessLabel ?? "Show less"
        : button.dataset.moreLabel ?? "Show more";
      content.hidden = !nextOpen;
      block.classList.toggle("is-open", nextOpen);
    });
  });

  const carousel = document.querySelector<HTMLElement>("[data-carousel]");

  if (carousel) {
    const track = carousel.querySelector<HTMLElement>("[data-carousel-track]");
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>("[data-carousel-card]"));
    const previous = carousel.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = carousel.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const status = carousel.querySelector<HTMLElement>("[data-carousel-status]");
    let index = 0;
    let timer: number | undefined;

    const getPerPage = () => {
      if (window.matchMedia("(max-width: 680px)").matches) {
        return 1;
      }

      if (window.matchMedia("(max-width: 920px)").matches) {
        return 2;
      }

      return 3;
    };

    const updateCarousel = (nextIndex: number, behavior: ScrollBehavior = "smooth") => {
      if (!track || cards.length === 0) {
        return;
      }

      const perPage = getPerPage();
      const maxIndex = Math.max(cards.length - perPage, 0);

      if (nextIndex > maxIndex) {
        index = 0;
      } else if (nextIndex < 0) {
        index = maxIndex;
      } else {
        index = nextIndex;
      }

      const activeCard = cards[index];
      track.scrollTo({
        left: activeCard.offsetLeft - track.offsetLeft,
        behavior,
      });

      cards.forEach((card, cardIndex) => {
        const visible = cardIndex >= index && cardIndex < index + perPage;
        card.setAttribute("aria-hidden", String(!visible));

        card
          .querySelectorAll<HTMLElement>("a, button, input, select, textarea, [tabindex]")
          .forEach((control) => {
            if (!("carouselTabindex" in control.dataset)) {
              control.dataset.carouselTabindex = control.getAttribute("tabindex") ?? "none";
            }

            if (visible) {
              if (control.dataset.carouselTabindex === "none") {
                control.removeAttribute("tabindex");
              } else if (control.dataset.carouselTabindex) {
                control.setAttribute("tabindex", control.dataset.carouselTabindex);
              }
            } else {
              control.setAttribute("tabindex", "-1");
            }
          });
      });

      if (status) {
        const lastVisible = Math.min(index + perPage, cards.length);
        status.textContent = `${index + 1}-${lastVisible} / ${cards.length}`;
      }
    };

    const stopAutoPlay = () => {
      if (timer) {
        window.clearInterval(timer);
      }
    };

    const startAutoPlay = () => {
      stopAutoPlay();
      timer = window.setInterval(() => {
        updateCarousel(index + getPerPage());
      }, 6500);
    };

    previous?.addEventListener("click", () => updateCarousel(index - getPerPage()));
    next?.addEventListener("click", () => updateCarousel(index + getPerPage()));
    carousel.addEventListener("mouseenter", stopAutoPlay);
    carousel.addEventListener("mouseleave", startAutoPlay);
    carousel.addEventListener("focusin", stopAutoPlay);
    carousel.addEventListener("focusout", startAutoPlay);
    window.addEventListener("resize", () => updateCarousel(index, "auto"));

    updateCarousel(0, "auto");
    startAutoPlay();
  }
</script>
