---
const {
  title = "Kwaku Richter",
  description = "Mechanical engineering, embedded systems, and robotics portfolio for Kwaku Richter.",
} = Astro.props;

const navItems = [
  { href: "/about/", label: "About" },
  { href: "/downloads/kwaku-richter-resume.pdf", label: "Resume" },
  { href: "/projects/", label: "Projects" },
  { href: "/experience/", label: "Experience" },
  { href: "/contact/", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Kwaku Richter home">
        <img class="brand-mark" src="/images/general/logo.jpg" alt="" />
      </a>
      <nav aria-label="Primary navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-social" aria-label="Social links">
        <a href="https://www.linkedin.com/in/kwaku-richter/" aria-label="LinkedIn">
          <img src="/images/general/linkedin.png" alt="" />
        </a>
        <a href="https://github.com/kwakurichter" aria-label="GitHub">
          <img src="/images/general/github.webp" alt="" />
        </a>
        <a href="mailto:kwakurichter@gmail.com" aria-label="Email">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4.5 5h15A2.5 2.5 0 0 1 22 7.5v9A2.5 2.5 0 0 1 19.5 19h-15A2.5 2.5 0 0 1 2 16.5v-9A2.5 2.5 0 0 1 4.5 5Zm0 2c-.2 0-.4.1-.5.2l8 5.2 8-5.2a.8.8 0 0 0-.5-.2h-15Zm15 10c.3 0 .5-.2.5-.5V9.3l-7.5 4.8a1 1 0 0 1-1 0L4 9.3v7.2c0 .3.2.5.5.5h15Z" />
          </svg>
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img class="footer-logo" src="/images/general/logo.jpg" alt="" />
        <strong>Kwaku Richter</strong>
      </div>
      <div class="footer-links">
        <a href="mailto:kwakurichter@gmail.com">kwakurichter@gmail.com</a>
        <a href="https://www.linkedin.com/in/kwaku-richter/">LinkedIn</a>
        <a href="https://github.com/kwakurichter">GitHub</a>
        <a href="/downloads/kwaku-richter-resume.pdf">Resume</a>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --white: #ffffff;
    --off-white: #f0f0f0;
    --mid-gray: #b0b0b0;
    --dark-gray: #707070;
    --charcoal: #333333;
    --ink: var(--charcoal);
    --muted: var(--dark-gray);
    --line: color-mix(in srgb, var(--mid-gray) 78%, transparent);
    --paper: var(--off-white);
    --surface: var(--white);
    --accent: var(--charcoal);
    --accent-2: var(--dark-gray);
    --deep: var(--charcoal);
    --deep-muted: var(--off-white);
    --max: 1180px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    line-height: 1.6;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
    text-underline-offset: 0.18em;
  }

  a:hover {
    text-decoration-color: currentColor;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.08;
    letter-spacing: 0;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(3rem, 9vw, 7rem);
  }

  h2 {
    font-size: clamp(2rem, 5vw, 4rem);
  }

  h3 {
    font-size: 1.15rem;
  }

  p {
    color: var(--muted);
  }

  .site-header,
  .site-footer,
  .section,
  .hero {
    padding-left: max(24px, calc((100vw - var(--max)) / 2));
    padding-right: max(24px, calc((100vw - var(--max)) / 2));
  }

  .site-header {
    position: relative;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 116px;
    border-bottom: 0;
    background: var(--white);
  }

  .brand,
  nav,
  .footer-links,
  .header-social {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .brand {
    gap: 24px;
    font-size: 1.55rem;
    font-weight: 780;
    text-decoration: none;
  }

  .brand-mark {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  nav {
    flex: 1;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 26px;
  }

  nav a,
  .footer-links a,
  .button,
  .tag {
    font-size: 0.9rem;
    font-weight: 650;
  }

  nav a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
  }

  nav a::after {
    position: absolute;
    right: 0;
    bottom: -6px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms ease;
  }

  nav a:hover {
    color: var(--ink);
  }

  nav a:hover::after,
  nav a:focus-visible::after {
    transform: scaleX(1);
  }

  .header-social {
    gap: 18px;
  }

  .header-social a {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    color: var(--ink);
  }

  .header-social svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }

  .header-social img {
    width: 22px;
    height: 22px;
    object-fit: contain;
  }

  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(860px, calc(100vh - 116px));
    padding-top: 96px;
    padding-bottom: 96px;
    overflow: hidden;
    background-position: center;
    background-size: cover;
    color: var(--white);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    max-width: 820px;
  }

  .hero::before {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(22 22 22 / 62%), rgb(31 33 28 / 34%)),
      rgb(22 22 22 / 22%);
    content: "";
  }

  .hero h1 {
    color: var(--white);
    font-size: clamp(4rem, 10vw, 7.6rem);
    font-weight: 400;
  }

  .hero p {
    color: var(--white);
  }

  .eyebrow {
    margin-bottom: 18px;
    color: var(--accent);
    font-size: clamp(1rem, 1.4vw, 1.22rem);
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lede {
    max-width: 760px;
    font-size: clamp(1.12rem, 2vw, 1.45rem);
  }

  .hero-actions,
  .card-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 18px;
    border: 1px solid var(--deep);
    background: var(--deep);
    color: var(--white);
    text-decoration: none;
    transition:
      background-color 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .button.secondary {
    background: transparent;
    color: var(--deep);
  }

  .button:hover,
  .button:focus-visible {
    border-color: var(--dark-gray);
    background: var(--dark-gray);
    color: var(--white);
    text-decoration: none;
    transform: translateY(-1px);
  }

  .button.secondary:hover,
  .button.secondary:focus-visible {
    border-color: var(--charcoal);
    background: var(--charcoal);
    color: var(--white);
  }

  .button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--mid-gray) 70%, transparent);
    outline-offset: 3px;
  }

  .hero .button {
    min-width: 180px;
    min-height: 56px;
    border-color: var(--white);
    background: var(--white);
    color: var(--ink);
    font-size: 1rem;
  }

  .hero .button:hover,
  .hero .button:focus-visible {
    border-color: var(--mid-gray);
    background: var(--mid-gray);
    color: var(--ink);
  }

  .intro-band {
    padding-top: 48px;
    padding-bottom: 56px;
    background: var(--white);
  }

  .intro-band .inner {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) auto;
    gap: 32px;
    align-items: center;
  }

  .intro-band p {
    max-width: 820px;
    margin-bottom: 0;
  }

  .hero-media {
    position: relative;
  }

  .hero-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .hero-stats,
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .hero-stats {
    margin-top: 16px;
  }

  .stat,
  .card {
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .stat {
    padding: 16px;
  }

  .stat strong {
    display: block;
    font-size: 1.35rem;
    line-height: 1;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .section {
    padding-top: 82px;
    padding-bottom: 82px;
  }

  .section.dark {
    background: var(--deep);
    color: var(--white);
  }

  .section.dark p,
  .section.dark .muted {
    color: var(--deep-muted);
  }

  .section.dark .card {
    color: var(--ink);
  }

  .section.dark .card p {
    color: var(--muted);
  }

  .section.dark .card-link,
  .section.dark .card h3 {
    color: var(--ink);
  }

  .section.dark .card .tag {
    border-color: var(--line);
    color: var(--charcoal);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 0.58fr);
    gap: 36px;
    align-items: end;
    margin-bottom: 34px;
  }

  .section-head.compact {
    display: block;
    max-width: 1040px;
  }

  .section-head.compact .eyebrow {
    margin-bottom: 10px;
  }

  .section-head.compact p:not(.eyebrow) {
    max-width: 980px;
  }

  .section-head.label-only {
    margin-bottom: 30px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .grid.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .grid.four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .carousel {
    display: grid;
    gap: 18px;
  }

  .carousel-track {
    display: flex;
    gap: 18px;
    overflow: hidden;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
  }

  .carousel-card {
    flex: 0 0 calc((100% - 36px) / 3);
    scroll-snap-align: start;
  }

  .carousel-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .carousel-status {
    min-width: 86px;
    color: var(--muted);
    font-size: 0.9rem;
    font-weight: 650;
    text-align: center;
  }

  .reveal-block {
    position: relative;
    display: grid;
    justify-items: center;
    margin-top: 0;
    padding-top: 32px;
  }

  .reveal-fade {
    position: absolute;
    top: -116px;
    right: 0;
    left: 0;
    height: 172px;
    pointer-events: none;
    background: linear-gradient(rgb(240 240 240 / 0%), var(--paper) 78%);
  }

  .section.dark .reveal-fade {
    background: linear-gradient(
      rgb(51 51 51 / 0%),
      rgb(51 51 51 / 76%) 54%,
      var(--deep) 100%
    );
  }

  .reveal-block.is-open .reveal-fade {
    display: none;
  }

  .reveal-toggle {
    position: relative;
    z-index: 1;
    width: min(100%, 980px);
    min-height: 66px;
    gap: 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 72%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 18px 38px rgb(22 22 22 / 12%);
    font-size: 1rem;
  }

  .section.dark .reveal-toggle {
    border-color: color-mix(in srgb, var(--mid-gray) 68%, transparent);
    background: rgb(51 51 51 / 64%);
    color: var(--white);
    box-shadow: 0 18px 38px rgb(0 0 0 / 20%);
  }

  .reveal-toggle::after {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    content: "";
    transform: translateY(-2px) rotate(45deg);
    transition: transform 160ms ease;
  }

  .reveal-toggle[aria-expanded="true"]::after {
    transform: translateY(3px) rotate(225deg);
  }

  .section.dark .reveal-toggle:hover,
  .section.dark .reveal-toggle:focus-visible {
    border-color: var(--white);
    background: rgb(80 80 80 / 74%);
    color: var(--white);
  }

  .reveal-content {
    width: 100%;
    margin-top: 34px;
  }

  .card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
  }

  .card img {
    width: 100%;
    aspect-ratio: 16 / 10;
    border-bottom: 1px solid var(--line);
    object-fit: cover;
    background: var(--off-white);
  }

  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }

  .card-body p:last-child {
    margin-bottom: 0;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 10px;
    border: 1px solid var(--line);
    color: var(--muted);
  }

  .card-link {
    margin-top: auto;
    padding-top: 18px;
    font-weight: 750;
  }

  .split {
    display: grid;
    grid-template-columns: 0.42fr 0.58fr;
    gap: 52px;
    align-items: center;
  }

  .split img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px;
  }

  .skills ul,
  .article ul {
    padding-left: 1.15rem;
  }

  .skills li,
  .article li {
    margin-bottom: 0.35rem;
  }

  .article-shell {
    padding: 72px max(24px, calc((100vw - 860px) / 2));
  }

  .article {
    font-size: 1.04rem;
  }

  .article h1 {
    margin-bottom: 18px;
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .article h2 {
    margin-top: 2.4rem;
    font-size: clamp(1.7rem, 4vw, 2.5rem);
  }

  .article h3 {
    margin-top: 1.8rem;
  }

  .article-video {
    width: 100%;
    aspect-ratio: 16 / 9;
    margin: 32px 0;
    border: 1px solid var(--line);
    background: var(--ink);
  }

  .article-video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .article-figure {
    margin: 32px 0;
  }

  .article-figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--line);
    background: var(--white);
  }

  .article-figure figcaption {
    margin-top: 10px;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin: 32px 0;
  }

  .article-grid.three {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .article-grid .article-figure {
    margin: 0;
  }

  .article-link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 24px 0;
  }

  .article-photo {
    margin: 32px 0;
  }

  .article-photo img,
  .article-media-row img {
    width: 100%;
    border: 1px solid var(--line);
  }

  .article-photo img {
    height: auto;
  }

  .article-media-row {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 0.58fr);
    gap: 30px;
    align-items: center;
    margin-top: 24px;
  }

  .article-media-row img {
    height: auto;
  }

  .article-media-row h3 {
    margin-top: 0;
  }

  .article-hero {
    width: 100%;
    max-height: 520px;
    margin: 32px 0;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 38px;
    padding-bottom: 38px;
    border-top: 1px solid var(--line);
    background: var(--white);
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .footer-logo {
    width: 46px;
    height: 46px;
    object-fit: contain;
  }

  @media (max-width: 920px) {
    .hero,
    .section-head,
    .split,
    .article-media-row,
    .article-grid,
    .article-grid.three,
    .intro-band .inner {
      grid-template-columns: 1fr;
    }

    .grid,
    .grid.two,
    .grid.four,
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .carousel-card {
      flex-basis: calc((100% - 18px) / 2);
    }
  }

  @media (max-width: 680px) {
    .site-header,
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    .hero {
      min-height: auto;
      padding-top: 48px;
      padding-bottom: 52px;
    }

    .site-header {
      min-height: auto;
      padding-top: 22px;
      padding-bottom: 22px;
    }

    .hero-stats,
    .stats-grid,
    .grid:not(.experience-grid),
    .grid.two,
    .skills {
      grid-template-columns: 1fr;
    }

    .experience-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .carousel-card {
      flex-basis: 100%;
    }

    .section {
      padding-top: 58px;
      padding-bottom: 58px;
    }
  }
</style>
