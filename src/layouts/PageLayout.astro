---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} | Kwaku Richter`} description={frontmatter.description}>
  <article class="article-shell article">
    <p class="eyebrow">{frontmatter.eyebrow ?? "Portfolio"}</p>
    <slot />
  </article>
</BaseLayout>
